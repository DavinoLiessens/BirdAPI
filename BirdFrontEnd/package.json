{
  "name": "bird-front-end",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:production": "ng build --configuration=production",
    "build:production:clean": "node -e \"const fs = require('fs'); const path = require('path'); const dir = path.join(__dirname, '../Backend/BirdAPI/ClientApp'); if (fs.existsSync(dir)) { fs.rmSync(dir, { recursive: true, force: true }); }\" && ng build --configuration=production",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "@primeuix/themes": "^3.1.1",
    "ngx-toastr": "^20.0.5",
    "primeflex": "^2.0.0",
    "primeicons": "^4.1.0",
    "primeng": "^22.1.5",
    "rxjs": "7.8",
    "scss-scaffold": "0.0.5",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@types/jasmine": "~3.6.0",
    "@types/node": "^12.11.1",
    "jasmine-core": "~3.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "ngx-toastr": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common"
    }
  }
}
